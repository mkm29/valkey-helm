{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "description": "Globally shared configuration"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "description": "Number of Valkey/Sentinel pods to run (must be at least 3 if using sentinel mode)"
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "description": "Valkey Docker image to use"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ],
          "description": "Image pull policy (Always, IfNotPresent, Never)"
        },
        "tag": {
          "type": "string",
          "description": "Image tag (leave empty to use .Chart.AppVersion)"
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "description": "Secrets with credentials to pull images from a private registry"
    },
    "config": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "standalone",
            "sentinel"
          ],
          "description": "Deployment mode, possible values: standalone, sentinel"
        },
        "logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "verbose",
            "notice",
            "warning"
          ],
          "description": "Valkey logging level: debug, verbose, notice, warning"
        },
        "valkey": {
          "type": "string",
          "description": "Content for valkey.conf (will be mounted via ConfigMap)"
        },
        "sentinel": {
          "type": "string",
          "description": "Content for sentinel.conf (used only if mode is sentinel)"
        }
      }
    },
    "valkey": {
      "type": "object",
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of Valkey pods to run (overrides global replicaCount for Valkey)"
        },
        "resources": {
          "type": "object",
          "description": "Resource limits/requests for the main Valkey container"
        },
        "initResources": {
          "type": "object",
          "description": "Resource limits/requests for init containers"
        },
        "extraSecrets": {
          "type": "array",
          "description": "Mount additional secrets into the Valkey container"
        },
        "extraConfigs": {
          "type": "array",
          "description": "Mount additional configMaps into the Valkey container"
        },
        "metrics": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false,
              "description": "Enable Prometheus exporter sidecar"
            },
            "exporter": {
              "type": "object",
              "description": "Exporter configuration",
              "properties": {
                "command": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "default": [],
                  "description": "Command to run in the metrics exporter container (overrides args)"
                },
                "args": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "default": [],
                  "description": "Arguments to pass to the metrics exporter container"
                },
                "port": {
                  "type": "integer",
                  "default": 9121,
                  "description": "Port on which the metrics exporter will listen"
                },
                "image": {
                  "type": "object",
                  "description": "Image configuration",
                  "properties": {
                    "repository": {
                      "type": "string",
                      "default": "ghcr.io/oliver006/redis_exporter",
                      "description": "Prometheus exporter Docker image"
                    },
                    "pullPolicy": {
                      "type": "string",
                      "enum": [
                        "Always",
                        "IfNotPresent",
                        "Never"
                      ],
                      "default": "IfNotPresent",
                      "description": "Image pull policy (Always, IfNotPresent, Never)"
                    },
                    "tag": {
                      "type": "string",
                      "default": "v1.79.0",
                      "description": "Image tag (leave empty to use latest)"
                    }
                  }
                },
                "resources": {
                  "type": "object",
                  "default": {},
                  "description": "Resource limits/requests for the metrics exporter container"
                },
                "extraVolumeMounts": {
                  "type": "array",
                  "default": [],
                  "description": "Extra volume mounts for metrics exporter container"
                },
                "extraEnvs": {
                  "type": "object",
                  "default": {},
                  "description": "Environment variables to inject into the metrics exporter container"
                },
                "securityContext": {
                  "type": "object",
                  "default": {},
                  "description": "Security context for the metrics exporter container"
                }
              }
            },
            "service": {
              "type": "object",
              "description": "Service configuration for the metrics exporter",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true,
                  "description": "Enable a separate service for the metrics exporter"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "ClusterIP",
                    "NodePort",
                    "LoadBalancer"
                  ],
                  "default": "ClusterIP",
                  "description": "Service type (ClusterIP, NodePort, LoadBalancer)"
                },
                "ports": {
                  "type": "object",
                  "description": "Port on which the metrics exporter service will be exposed",
                  "properties": {
                    "http": {
                      "type": "integer",
                      "default": 9121
                    }
                  }
                },
                "annotations": {
                  "type": "object",
                  "default": {},
                  "description": "Optional annotations for the metrics exporter service"
                },
                "extraLabels": {
                  "type": "object",
                  "default": {},
                  "description": "Optional labels for the metrics exporter service"
                }
              }
            },
            "serviceMonitor": {
              "type": "object",
              "description": "ServiceMonitor configuration for Prometheus Operator",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": false,
                  "description": "Enable ServiceMonitor resource for scraping service metrics"
                },
                "port": {
                  "type": "string",
                  "default": "metrics",
                  "description": "Port name or number to scrape metrics from"
                },
                "extraLabels": {
                  "type": "object",
                  "default": {},
                  "description": "Extra labels for the ServiceMonitor resource"
                },
                "annotations": {
                  "type": "object",
                  "default": {},
                  "description": "Extra annotations for the ServiceMonitor resource"
                },
                "interval": {
                  "type": "string",
                  "default": "30s",
                  "description": "How often Prometheus should scrape metrics"
                },
                "scrapeTimeout": {
                  "type": "string",
                  "default": "",
                  "description": "Maximum duration allowed for a scrape request"
                },
                "relabelings": {
                  "type": "array",
                  "default": [],
                  "description": "Relabeling rules applied before scraping metrics"
                },
                "metricRelabelings": {
                  "type": "array",
                  "default": [],
                  "description": "Relabeling rules applied before ingesting metrics"
                },
                "honorLabels": {
                  "type": "boolean",
                  "default": false,
                  "description": "Set honorLabels to true to preserve original metric labels"
                },
                "additionalLabels": {
                  "type": "object",
                  "default": {},
                  "description": "Extra labels to help Prometheus discover ServiceMonitor resources"
                },
                "podTargetLabels": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "default": [],
                  "description": "Pod labels to copy onto the generated metrics"
                },
                "sampleLimit": {
                  "type": "boolean",
                  "default": false,
                  "description": "Maximum number of samples to collect per Pod scrape"
                },
                "targetLimit": {
                  "type": "boolean",
                  "default": false,
                  "description": "Maximum number of scrape targets allowed"
                }
              }
            },
            "podMonitor": {
              "type": "object",
              "description": "PodMonitor configuration for Prometheus Operator",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": false,
                  "description": "Enable PodMonitor resource for scraping pod metrics"
                },
                "port": {
                  "type": "string",
                  "default": "metrics",
                  "description": "Port name or number to scrape metrics from"
                },
                "extraLabels": {
                  "type": "object",
                  "default": {},
                  "description": "Extra labels for the PodMonitor resource"
                },
                "annotations": {
                  "type": "object",
                  "default": {},
                  "description": "Extra annotations for the PodMonitor resource"
                },
                "interval": {
                  "type": "string",
                  "default": "30s",
                  "description": "Frequency for Prometheus to scrape pod metrics"
                },
                "scrapeTimeout": {
                  "type": "string",
                  "default": "",
                  "description": "Time limit for each scrape operation"
                },
                "relabelings": {
                  "type": "array",
                  "default": [],
                  "description": "Relabeling rules to apply before scraping pod metrics"
                },
                "metricRelabelings": {
                  "type": "array",
                  "default": [],
                  "description": "Relabeling rules to apply before ingesting pod metrics"
                },
                "honorLabels": {
                  "type": "boolean",
                  "default": false,
                  "description": "If true, keeps original labels from the pod metrics"
                },
                "additionalLabels": {
                  "type": "object",
                  "default": {},
                  "description": "Additional labels for Prometheus to find PodMonitor resources"
                },
                "podTargetLabels": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "default": [],
                  "description": "Pod labels to attach to the metrics"
                },
                "sampleLimit": {
                  "type": "boolean",
                  "default": false,
                  "description": "Maximum samples to scrape from each Pod"
                },
                "targetLimit": {
                  "type": "boolean",
                  "default": false,
                  "description": "Maximum number of pods to scrape"
                }
              }
            },
            "prometheusRule": {
              "type": "object",
              "description": "PrometheusRule configuration for alerting rules (used by kube-prometheus-stack)",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": false,
                  "description": "Enable creation of PrometheusRule resource"
                },
                "extraLabels": {
                  "type": "object",
                  "default": {},
                  "description": "Extra labels to add to the PrometheusRule resource"
                },
                "extraAnnotations": {
                  "type": "object",
                  "default": {},
                  "description": "Extra annotations to add to the PrometheusRule resource"
                },
                "rules": {
                  "type": "array",
                  "default": [],
                  "description": "List of Prometheus alerting rules"
                }
              }
            }
          }
        }
      }
    },
    "sentinel": {
      "type": "object",
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of Sentinel pods to run (overrides global replicaCount for Sentinel)"
        },
        "port": {
          "type": "integer",
          "description": "Sentinel port"
        },
        "quorum": {
          "type": "integer",
          "minimum": 2,
          "description": "Quorum: number of Sentinels that must agree primary is down"
        },
        "downAfterMilliseconds": {
          "type": "integer",
          "description": "Time before instance considered down (milliseconds)"
        },
        "failoverTimeout": {
          "type": "integer",
          "description": "Failover timeout in milliseconds"
        },
        "parallelSyncs": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of replicas syncing simultaneously during failover"
        },
        "announce": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Enable announce configuration"
            }
          }
        },
        "resources": {
          "type": "object",
          "description": "Resource limits/requests for the Sentinel container"
        },
        "extraSecrets": {
          "type": "array",
          "description": "Mount additional secrets into the Sentinel container"
        },
        "extraConfigs": {
          "type": "array",
          "description": "Mount additional configMaps into the Sentinel container"
        },
        "metrics": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false,
              "description": "Enable Prometheus exporter sidecar"
            },
            "exporter": {
              "type": "object",
              "description": "Exporter configuration",
              "properties": {
                "command": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "default": [],
                  "description": "Command to run in the metrics exporter container (overrides args)"
                },
                "args": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "default": [],
                  "description": "Arguments to pass to the metrics exporter container"
                },
                "port": {
                  "type": "integer",
                  "default": 9121,
                  "description": "Port on which the metrics exporter will listen"
                },
                "image": {
                  "type": "object",
                  "description": "Image configuration",
                  "properties": {
                    "repository": {
                      "type": "string",
                      "default": "ghcr.io/oliver006/redis_exporter",
                      "description": "Prometheus exporter Docker image"
                    },
                    "pullPolicy": {
                      "type": "string",
                      "enum": [
                        "Always",
                        "IfNotPresent",
                        "Never"
                      ],
                      "default": "IfNotPresent",
                      "description": "Image pull policy (Always, IfNotPresent, Never)"
                    },
                    "tag": {
                      "type": "string",
                      "default": "v1.79.0",
                      "description": "Image tag (leave empty to use latest)"
                    }
                  }
                },
                "resources": {
                  "type": "object",
                  "default": {},
                  "description": "Resource limits/requests for the metrics exporter container"
                },
                "extraVolumeMounts": {
                  "type": "array",
                  "default": [],
                  "description": "Extra volume mounts for metrics exporter container"
                },
                "extraEnvs": {
                  "type": "object",
                  "default": {},
                  "description": "Environment variables to inject into the metrics exporter container"
                },
                "securityContext": {
                  "type": "object",
                  "default": {},
                  "description": "Security context for the metrics exporter container"
                }
              }
            },
            "service": {
              "type": "object",
              "description": "Service configuration for the metrics exporter",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true,
                  "description": "Enable a separate service for the metrics exporter"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "ClusterIP",
                    "NodePort",
                    "LoadBalancer"
                  ],
                  "default": "ClusterIP",
                  "description": "Service type (ClusterIP, NodePort, LoadBalancer)"
                },
                "ports": {
                  "type": "object",
                  "description": "Port on which the metrics exporter service will be exposed",
                  "properties": {
                    "http": {
                      "type": "integer",
                      "default": 9121
                    }
                  }
                },
                "annotations": {
                  "type": "object",
                  "default": {},
                  "description": "Optional annotations for the metrics exporter service"
                },
                "extraLabels": {
                  "type": "object",
                  "default": {},
                  "description": "Optional labels for the metrics exporter service"
                }
              }
            },
            "serviceMonitor": {
              "type": "object",
              "description": "ServiceMonitor configuration for Prometheus Operator",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": false,
                  "description": "Enable ServiceMonitor resource for scraping service metrics"
                },
                "port": {
                  "type": "string",
                  "default": "metrics",
                  "description": "Port name or number to scrape metrics from"
                },
                "extraLabels": {
                  "type": "object",
                  "default": {},
                  "description": "Extra labels for the ServiceMonitor resource"
                },
                "annotations": {
                  "type": "object",
                  "default": {},
                  "description": "Extra annotations for the ServiceMonitor resource"
                },
                "interval": {
                  "type": "string",
                  "default": "30s",
                  "description": "How often Prometheus should scrape metrics"
                },
                "scrapeTimeout": {
                  "type": "string",
                  "default": "",
                  "description": "Maximum duration allowed for a scrape request"
                },
                "relabelings": {
                  "type": "array",
                  "default": [],
                  "description": "Relabeling rules applied before scraping metrics"
                },
                "metricRelabelings": {
                  "type": "array",
                  "default": [],
                  "description": "Relabeling rules applied before ingesting metrics"
                },
                "honorLabels": {
                  "type": "boolean",
                  "default": false,
                  "description": "Set honorLabels to true to preserve original metric labels"
                },
                "additionalLabels": {
                  "type": "object",
                  "default": {},
                  "description": "Extra labels to help Prometheus discover ServiceMonitor resources"
                },
                "podTargetLabels": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "default": [],
                  "description": "Pod labels to copy onto the generated metrics"
                },
                "sampleLimit": {
                  "type": "boolean",
                  "default": false,
                  "description": "Maximum number of samples to collect per Pod scrape"
                },
                "targetLimit": {
                  "type": "boolean",
                  "default": false,
                  "description": "Maximum number of scrape targets allowed"
                }
              }
            },
            "podMonitor": {
              "type": "object",
              "description": "PodMonitor configuration for Prometheus Operator",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": false,
                  "description": "Enable PodMonitor resource for scraping pod metrics"
                },
                "port": {
                  "type": "string",
                  "default": "metrics",
