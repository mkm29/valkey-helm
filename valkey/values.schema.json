{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
        "global": {
            "type": "object",
            "description": "Globally shared configuration"
        },
        "replicaCount": {
            "type": "integer",
            "minimum": 1,
            "description": "Number of Valkey/Sentinel pods to run (must be at least 3 if using sentinel mode)"
        },
        "image": {
            "type": "object",
            "properties": {
                "repository": {
                    "type": "string",
                    "description": "Valkey Docker image to use"
                },
                "pullPolicy": {
                    "type": "string",
                    "enum": ["Always", "IfNotPresent", "Never"],
                    "description": "Image pull policy (Always, IfNotPresent, Never)"
                },
                "tag": {
                    "type": "string",
                    "description": "Image tag (leave empty to use .Chart.AppVersion)"
                }
            }
        },
        "imagePullSecrets": {
            "type": "array",
            "description": "Secrets with credentials to pull images from a private registry"
        },
        "config": {
            "type": "object",
            "properties": {
                "mode": {
                    "type": "string",
                    "enum": ["standalone", "sentinel"],
                    "description": "Deployment mode, possible values: standalone, sentinel"
                },
                "logLevel": {
                    "type": "string",
                    "enum": ["debug", "verbose", "notice", "warning"],
                    "description": "Valkey logging level: debug, verbose, notice, warning"
                },
                "valkey": {
                    "type": "string",
                    "description": "Content for valkey.conf (will be mounted via ConfigMap)"
                },
                "sentinel": {
                    "type": "string",
                    "description": "Content for sentinel.conf (used only if mode is sentinel)"
                }
            }
        },
        "valkey": {
            "type": "object",
            "properties": {
                "networkPolicy": {
                    "type": "object",
                    "description": "Network policy to control traffic to/from the Valkey pods"
                },
                "resources": {
                    "type": "object",
                    "description": "Resource limits/requests for the main Valkey container"
                },
                "initResources": {
                    "type": "object",
                    "description": "Resource limits/requests for init containers"
                },
                "auth": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "description": "Enable ACL-based authentication"
                        },
                        "password": {
                            "type": "string",
                            "description": "Authentication password"
                        },
                        "existingSecret": {
                            "type": "string",
                            "description": "Existing secret containing password"
                        },
                        "existingSecretPasswordKey": {
                            "type": "string",
                            "description": "Key in existing secret containing password"
                        },
                        "aclConfig": {
                            "type": "string",
                            "description": "Default ACL rules (used only if auth.enabled is true)"
                        }
                    }
                },
                "extraSecrets": {
                    "type": "array",
                    "description": "Mount additional secrets into the Valkey container"
                },
                "extraConfigs": {
                    "type": "array",
                    "description": "Mount additional configMaps into the Valkey container"
                }
            }
        },
        "sentinel": {
            "type": "object",
            "properties": {
                "port": {
                    "type": "integer",
                    "description": "Sentinel port"
                },
                "quorum": {
                    "type": "integer",
                    "minimum": 2,
                    "description": "Quorum: number of Sentinels that must agree primary is down"
                },
                "downAfterMilliseconds": {
                    "type": "integer",
                    "description": "Time before instance considered down (milliseconds)"
                },
                "failoverTimeout": {
                    "type": "integer",
                    "description": "Failover timeout in milliseconds"
                },
                "parallelSyncs": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Number of replicas syncing simultaneously during failover"
                },
                "auth": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "description": "Enable Sentinel authentication"
                        },
                        "password": {
                            "type": "string",
                            "description": "Sentinel authentication password"
                        },
                        "existingSecret": {
                            "type": "string",
                            "description": "Existing secret containing Sentinel password"
                        },
                        "existingSecretPasswordKey": {
                            "type": "string",
                            "description": "Key in existing secret containing Sentinel password"
                        }
                    }
                },
                "announce": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "description": "Enable announce configuration"
                        }
                    }
                },
                "networkPolicy": {
                    "type": "object",
                    "description": "Network policy to control traffic to/from the Sentinel pods"
                },
                "resources": {
                    "type": "object",
                    "description": "Resource limits/requests for the Sentinel container"
                },
                "extraSecrets": {
                    "type": "array",
                    "description": "Mount additional secrets into the Sentinel container"
                },
                "extraConfigs": {
                    "type": "array",
                    "description": "Mount additional configMaps into the Sentinel container"
                }
            }
        },
        "nameOverride": {
            "type": "string",
            "description": "Override the default name of resources"
        },
        "fullnameOverride": {
            "type": "string",
            "description": "Override the full name of resources"
        },
        "serviceAccount": {
            "type": "object",
            "properties": {
                "create": {
                    "type": "boolean",
                    "description": "Create a service account for Valkey"
                },
                "automount": {
                    "type": "boolean",
                    "description": "Whether to automount the service account token"
                },
                "annotations": {
                    "type": "object",
                    "description": "Annotations to add to the service account"
                },
                "name": {
                    "type": "string",
                    "description": "Name of an existing service account to use (if create: false)"
                }
            }
        },
        "podAnnotations": {
            "type": "object",
            "description": "Annotations for the pods"
        },
        "podLabels": {
            "type": "object",
            "description": "Labels for the pods"
        },
        "podSecurityContext": {
            "type": "object",
            "properties": {
                "fsGroup": {
                    "type": "integer",
                    "description": "File system group ID"
                },
                "runAsUser": {
                    "type": "integer",
                    "description": "User ID to run containers as"
                },
                "runAsGroup": {
                    "type": "integer",
                    "description": "Group ID to run containers as"
                }
            },
            "description": "Security context for the pod (applies to all containers)"
        },
        "securityContext": {
            "type": "object",
            "properties": {
                "capabilities": {
                    "type": "object",
                    "properties": {
                        "drop": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "description": "Capabilities to drop"
                        }
                    }
                },
                "readOnlyRootFilesystem": {
                    "type": "boolean",
                    "description": "Mount root filesystem as read-only"
                },
                "runAsNonRoot": {
                    "type": "boolean",
                    "description": "Run as non-root user"
                },
                "runAsUser": {
                    "type": "integer",
                    "description": "User ID to run container as"
                }
            },
            "description": "Security context for the Valkey containers"
        },
        "service": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "enum": ["ClusterIP", "NodePort", "LoadBalancer"],
                    "description": "Type of Kubernetes service (ClusterIP, NodePort, LoadBalancer)"
                },
                "port": {
                    "type": "integer",
                    "description": "Port on which Valkey will be exposed"
                },
                "annotations": {
                    "type": "object",
                    "description": "Annotations for the service"
                },
                "nodePort": {
                    "type": "integer",
                    "description": "NodePort value (if service.type is NodePort)"
                }
            }
        },
        "dataStorage": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "description": "Enable persistent volume claim creation"
                },
                "persistentVolumeClaimName": {
                    "type": "string",
                    "description": "Use existing PVC by name (skip dynamic provisioning if set)"
                },
                "subPath": {
                    "type": "string",
                    "description": "Subpath inside PVC to mount"
                },
                "volumeName": {
                    "type": "string",
                    "description": "Name of the volume (referenced in deployment)"
                },
                "requestedSize": {
                    "type": "string",
                    "description": "Request size (e.g. 5Gi) for dynamically provisioned volume"
                },
                "className": {
                    "type": "string",
                    "description": "Name of the storage class to use"
                },
                "accessModes": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Access modes for the PVC (e.g., ReadWriteOnce, ReadWriteMany)"
                },
                "keepPvc": {
                    "type": "boolean",
                    "description": "If true, keep the PVC on Helm uninstall"
                },
                "annotations": {
                    "type": "object",
                    "description": "Optional annotations to add to the PVC"
                },
                "labels": {
                    "type": "object",
                    "description": "Optional labels to add to the PVC"
                }
            }
        },
        "extraStorage": {
            "type": "array",
            "description": "Mount additional emptyDir or hostPath volumes (advanced use)"
        },
        "nodeSelector": {
            "type": "object",
            "description": "Node selector for pod assignment"
        },
        "tolerations": {
            "type": "array",
            "description": "Tolerations for pod assignment to tainted nodes"
        },
        "affinity": {
            "type": "object",
            "description": "Affinity rules for pod scheduling"
        },
        "deploymentStrategy": {
            "type": "string",
            "enum": ["RollingUpdate", "Recreate"],
            "description": "Set Deployment strategy"
        },
        "topologySpreadConstraints": {
            "type": "array",
            "items": {
                "type": "object"
            },
            "description": "Topology spread constraints for pod scheduling"
        },
        "metrics": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "description": "Enable Prometheus exporter sidecar"
                },
                "exporter": {
                    "type": "object",
                    "properties": {
                        "extraExporterSecrets": {
                            "type": "array",
                            "description": "Additional secrets to mount for metrics exporter"
                        },
                        "command": {
                            "type": "array"
                        },
                        "args": {
                            "type": "array"
                        },
                        "port": {
                            "type": "integer"
                        },
                        "image": {
                            "type": "object"
                        },
                        "resources": {
                            "type": "object"
                        },
                        "extraVolumeMounts": {
                            "type": "array"
                        },
                        "extraEnvs": {
                            "type": "object"
                        },
                        "securityContext": {
                            "type": "object"
                        }
                    }
                },
                "service": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        },
                        "type": {
                            "type": "string"
                        },
                        "ports": {
                            "type": "object"
                        },
                        "annotations": {
                            "type": "object"
                        },
                        "extraLabels": {
                            "type": "object"
                        }
                    }
                },
                "serviceMonitor": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        },
                        "port": {
                            "type": "string"
                        },
                        "extraLabels": {
                            "type": "object"
                        },
                        "annotations": {
                            "type": "object"
                        },
                        "interval": {
                            "type": "string"
                        },
                        "scrapeTimeout": {
                            "type": "string"
                        },
                        "relabelings": {
                            "type": "array"
                        },
                        "metricRelabelings": {
                            "type": "array"
                        },
                        "honorLabels": {
                            "type": "boolean"
                        },
                        "additionalLabels": {
                            "type": "object"
                        },
                        "podTargetLabels": {
                            "type": "array"
                        },
                        "sampleLimit": {
                            "type": "boolean"
                        },
                        "targetLimit": {
                            "type": "boolean"
                        }
                    }
                },
                "podMonitor": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        },
                        "port": {
                            "type": "string"
                        },
                        "extraLabels": {
                            "type": "object"
                        },
                        "annotations": {
                            "type": "object"
                        },
                        "interval": {
                            "type": "string"
                        },
                        "scrapeTimeout": {
                            "type": "string"
                        },
                        "relabelings": {
                            "type": "array"
                        },
                        "metricRelabelings": {
                            "type": "array"
                        },
                        "honorLabels": {
                            "type": "boolean"
                        },
                        "additionalLabels": {
                            "type": "object"
                        },
                        "podTargetLabels": {
                            "type": "array"
                        },
                        "sampleLimit": {
                            "type": "boolean"
                        },
                        "targetLimit": {
                            "type": "boolean"
                        }
                    }
                },
                "prometheusRule": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        },
                        "extraLabels": {
                            "type": "object"
                        },
                        "extraAnnotations": {
                            "type": "object"
                        },
                        "rules": {
                            "type": "array"
                        }
                    }
                }
            }
        },
        "env": {
            "type": "object",
            "description": "Environment variables to inject into Valkey container"
        }
    }
}
