                },
                "honorLabels": {
                  "type": "boolean",
                  "default": false,
                  "description": "If true, keeps original labels from the pod metrics"
                },
                "additionalLabels": {
                  "type": "object",
                  "default": {},
                  "description": "Additional labels for Prometheus to find PodMonitor resources"
                },
                "podTargetLabels": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "default": [],
                  "description": "Pod labels to attach to the metrics"
                },
