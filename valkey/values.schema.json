              }
            }
          }
        }
      }
    },
    "nameOverride": {
      "type": "string",
      "description": "Override the default name of resources"
    },
    "fullnameOverride": {
      "type": "string",
      "description": "Override the full name of resources"
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean",
          "description": "Create a service account for Valkey"
        },
        "automount": {
          "type": "boolean",
          "description": "Whether to automount the service account token"
        },
        "annotations": {
          "type": "object",
          "description": "Annotations to add to the service account"
        },
        "name": {
          "type": "string",
          "description": "Name of an existing service account to use (if create: false)"
        }
      }
    },
    "podAnnotations": {
      "type": "object",
      "description": "Annotations for the pods"
    },
    "podLabels": {
      "type": "object",
      "description": "Labels for the pods"
    },
    "podSecurityContext": {
      "type": "object",
      "properties": {
        "fsGroup": {
          "type": "integer",
          "description": "File system group ID"
        },
        "runAsUser": {
          "type": "integer",
          "description": "User ID to run containers as"
        },
        "runAsGroup": {
          "type": "integer",
          "description": "Group ID to run containers as"
        }
      },
      "description": "Security context for the pod (applies to all containers)"
    },
    "securityContext": {
      "type": "object",
      "properties": {
        "capabilities": {
          "type": "object",
          "properties": {
            "drop": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Capabilities to drop"
            }
          }
        },
        "readOnlyRootFilesystem": {
          "type": "boolean",
          "description": "Mount root filesystem as read-only"
        },
        "runAsNonRoot": {
          "type": "boolean",
          "description": "Run as non-root user"
        },
        "runAsUser": {
          "type": "integer",
          "description": "User ID to run container as"
        }
      },
      "description": "Security context for the Valkey containers"
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ],
          "description": "Type of Kubernetes service (ClusterIP, NodePort, LoadBalancer)"
        },
        "port": {
          "type": "integer",
          "description": "Port on which Valkey will be exposed"
        },
        "annotations": {
          "type": "object",
          "description": "Annotations for the service"
        },
        "nodePort": {
          "type": "integer",
          "description": "NodePort value (if service.type is NodePort)"
        },
        "enabled": {
          "type": "boolean",
          "description": "Enable the ClusterIP service for load-balanced client connections. A headless service is always created for StatefulSet DNS (this setting does not affect it)"
        }
      }
    },
    "dataStorage": {
      "type": "object",
      "description": "Persistent storage configuration for Valkey data (only applies to Valkey pods, not Sentinel pods)",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable persistent volume claim creation"
        },
        "requestedSize": {
          "type": "string",
          "description": "Storage size (e.g., 8Gi for production workloads)"
        },
        "className": {
          "type": "string",
          "description": "Storage class name (leave empty for default)"
        },
        "accessModes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Access modes for the PVC"
        },
        "annotations": {
          "type": "object",
          "description": "Optional annotations to add to the PVC"
        },
        "labels": {
          "type": "object",
          "description": "Optional labels to add to the PVC"
        },
        "volumeName": {
          "type": "string",
          "default": "data",
          "description": "Volume name to use for mounting data"
        },
        "subPath": {
          "type": "string",
          "description": "Optional subPath for the volume mount"
        },
        "persistentVolumeClaimName": {
          "type": "string",
          "description": "Use an existing PVC instead of creating a new one"
        },
        "keepPvc": {
          "type": "boolean",
          "default": false,
          "description": "Keep PVC when uninstalling (adds helm.sh/resource-policy: keep annotation)"
        }
      }
    },
    "nodeSelector": {
      "type": "object",
      "description": "Node selector for pod assignment"
    },
    "tolerations": {
      "type": "array",
      "description": "Tolerations for pod assignment to tainted nodes"
    },
    "affinity": {
      "type": "object",
      "description": "Affinity rules for pod scheduling"
    },
    "deploymentStrategy": {
      "type": "string",
      "enum": [
        "RollingUpdate",
        "Recreate"
      ],
      "description": "Set Deployment strategy"
    },
    "topologySpreadConstraints": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Topology spread constraints for pod scheduling"
    },
    "extraInitContainers": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Additional init containers to run before Valkey starts"
    },
    "env": {
      "type": "object",
      "description": "Environment variables to inject into Valkey container"
    },
    "networkPolicy": {
      "type": "object",
      "description": "Network policy to control traffic to/from the Valkey pods. Since Valkey and Sentinel run in the same pods (sidecar pattern), one policy applies to both."
    },
    "auth": {
      "type": "object",
      "description": "Authentication configuration (applies to both Valkey and Sentinel)",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable authentication. When false, authentication is completely disabled (equivalent to method: none). When true, uses the authentication method specified below."
        },
        "acl": {
          "type": "object",
          "description": "ACL-based authentication configuration",
          "properties": {
            "password": {
              "type": "string",
              "description": "Single password for simple setup (creates both default and sentinel users)"
            },
            "defaultUserPassword": {
              "type": "string",
              "description": "Password for the default user (application access)"
            },
            "sentinelUserPassword": {
              "type": "string",
              "description": "Password for the sentinel user (management access)"
            },
            "existingSecret": {
              "type": "string",
              "description": "Name of existing secret containing ACL passwords"
            },
            "existingSecretDefaultUserKey": {
              "type": "string",
              "description": "Key in secret for default user password"
            },
            "existingSecretSentinelUserKey": {
              "type": "string",
              "description": "Key in secret for sentinel user password"
            },
            "config": {
              "type": "string",
              "description": "Full custom ACL configuration"
            }
          }
        }
      }
    },
    "initSecurityContext": {
      "type": "object",
      "description": "Security context for init containers (should not include readOnlyRootFilesystem since init containers write configs)",
      "properties": {
        "runAsNonRoot": {
          "type": "boolean"
        },
        "runAsUser": {
          "type": "integer"
        },
        "runAsGroup": {
          "type": "integer"
        },
        "capabilities": {
          "type": "object",
          "properties": {
            "drop": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}